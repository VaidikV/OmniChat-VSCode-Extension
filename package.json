{
  "name": "omnichat-ai-vscode-ext",
  "displayName": "OmniChat AI",  
  "description": "Include any LLM in your VSCode workflow, including the new OpenAI open-weight models gpt-oss-120b and gpt-oss-20b. Test advanced local AI models like DeepSeek, Gemma3, GPT-OSS directly inside your editor without sending data to the cloud.",
  "version": "0.0.2",
  "publisher": "vaidikv",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other", "AI", "Machine Learning", "Data Science", "Chat", "Education", "Programming Languages" 
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "OmniChat.start",
        "title": "OmniChat: Start"
      },
      {
        "command": "OmniChat.setModel",
        "title": "OmniChat: Set Model"
      }
    ]
  },
  "keywords": [
    "vscode-extension",
    "llm",
    "ai-assistant",
    "ollama",
    "local-llm",
    "openai",
    "open-weight",
    "gpt-oss-120b",
    "gpt-oss-20b",
    "deepseek",
    "gemma3",
    "privacy-first",
    "offline-ai"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "author": "Vaidik Vadhavana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaidikV/OmniChat-VSCode-Extension"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ollama": "^0.5.12"
  }
}
