{
  "activationEvents": [],
  "author": "Vaidik Vadhavana",
  "categories": [
    "Other",
    "AI",
    "Machine Learning",
    "Data Science",
    "Chat",
    "Education",
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "omnichat.start",
        "title": "OmniChat: New chat"
      },
      {
        "command": "omnichat.switchModel",
        "title": "OmniChat: Switch model or provider"
      },
      {
        "command": "omnichat.setup",
        "title": "OmniChat: Setup"
      },
      {
        "command": "omnichat.askAboutSelection",
        "title": "OmniChat: Ask about selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "omnichat.askAboutSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnichat",
          "title": "OmniChat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "omnichat": [
        {
          "id": "omnichat.welcome",
          "name": "OmniChat"
        }
      ]
    },
    "configuration": {
      "properties": {
        "omnichat.custom.apiKeyRequired": {
          "default": false,
          "description": "Whether the custom endpoint requires an API key (stored in SecretStorage, never in settings).",
          "type": "boolean"
        },
        "omnichat.custom.baseUrl": {
          "default": "",
          "description": "Base URL of an OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, ...).",
          "type": "string"
        },
        "omnichat.custom.model": {
          "default": "",
          "description": "Default model id for the custom endpoint, used when the endpoint has no model list.",
          "type": "string"
        },
        "omnichat.ollama.baseUrl": {
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of the Ollama server.",
          "type": "string"
        },
        "omnichat.ollama.model": {
          "default": "",
          "description": "Ollama model id to chat with (e.g. qwen3:8b). Pick from the model switcher.",
          "type": "string"
        },
        "omnichat.openrouter.model": {
          "default": "openai/gpt-oss-20b",
          "description": "OpenRouter model id to chat with.",
          "type": "string"
        },
        "omnichat.provider": {
          "default": "ollama",
          "description": "Which LLM provider OmniChat uses.",
          "enum": [
            "ollama",
            "openrouter",
            "custom"
          ],
          "enumDescriptions": [
            "Run models locally via Ollama. Private: nothing leaves your machine.",
            "Use OpenRouter's cloud API. Requires an API key; prompts leave your machine.",
            "Any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, ...)."
          ],
          "type": "string"
        },
        "omnichat.requestTimeout": {
          "default": 300,
          "description": "Seconds without receiving a token before a request is treated as stalled and cancelled.",
          "minimum": 30,
          "type": "number"
        }
      },
      "title": "OmniChat"
    }
  },
  "dependencies": {},
  "description": "The simplest private AI assistant for VS Code. Chat with local models via Ollama, frontier models via OpenRouter, or any OpenAI-compatible endpoint, right inside your editor. Guided setup, selection context, and one-click code insertion.",
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "dompurify": "^3.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.16.0",
    "marked": "^16.0.0",
    "typescript": "^5.7.2"
  },
  "displayName": "OmniChat AI",
  "engines": {
    "vscode": "^1.96.0"
  },
  "icon": "icon.png",
  "keywords": [
    "vscode-extension",
    "llm",
    "ai-assistant",
    "ai-chat",
    "ollama",
    "openrouter",
    "openai-compatible",
    "local-llm",
    "code-assistant"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "omnichat-ai-vscode-ext",
  "publisher": "vaidikv",
  "repository": {
    "type": "git",
    "url": "https://github.com/VaidikV/OmniChat-VSCode-Extension"
  },
  "scripts": {
    "build:webview": "node build-webview.mjs",
    "compile": "npm run build:webview && tsc -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "npm run test:unit",
    "test:e2e": "vscode-test",
    "test:unit": "node --test \"out/**/*.test.js\"",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./"
  },
  "version": "0.1.0"
}
